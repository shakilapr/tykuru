{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tykuru",
  "version": "0.1.0",
  "identifier": "com.tykuru.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Tykuru",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/typst-x86_64-pc-windows-msvc"
    ],
    "publisher": "Tykuru contributors",
    "fileAssociations": [
      {
        "ext": ["typ"],
        "name": "Typst Document",
        "description": "Typst source document",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "shell": {
      "sidecar": [
        {
          "bin": "typst",
          "args": true
        }
      ]
    }
  }
}
