# Node / pnpm
node_modules/
dist/
.vite/
*.tsbuildinfo

# Rust / Tauri
src-tauri/target/
src-tauri/gen/
# Downloaded Typst sidecar (fetched by scripts/fetch_typst.ps1); keep the placeholder.
src-tauri/binaries/typst-*
!src-tauri/binaries/.gitkeep
*.pdb

# Generated PDFs (committed fixtures are source; only GENERATED output is ignored)
**/out/*.pdf
*.generated.pdf
candidate.pdf
revision-*.pdf

# Tykuru cache (runtime; lives under %LOCALAPPDATA%)
tykuru-cache/
cache/

# Logs
*.log
logs/

# Env / secrets
.env
.env.*
*.key
*.pem
*.pfx
*.sig
secrets*

# IDE / OS
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# Committed on purpose (do NOT ignore):
# Cargo.lock, pnpm-lock.yaml, components.json, src/**
